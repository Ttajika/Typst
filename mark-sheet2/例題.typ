// ===========================================================================
//  マークシート試験の記述例
//  ---------------------------------------------------------------------
//  通常採点・セット採点・順不同採点、選択肢ボックス、下線部の参照、
//  設問番号の相互参照をひととおり使っています。
//
//  組版:            typst compile 例題.typ
//  正答つきの版:    show-answer: true にして組版（正答と採点パターンが赤で入ります）
// ===========================================================================

#import "lib/template.typ": *

#show: project.with(
  title: [金融と公共経済　期末試験],
  N: 20,          // 解答欄の数。実際に使う設問数以上にしておく
  choice: 10,     // 選択肢の数（0〜9）
  ID_num: 7,      // 学籍番号の桁数
  show-answer: false,
)

// ---------------------------------------------------------------------------
// 通常採点：1設問に1つの正答。setmon を1つ置くごとに解答欄が1つ進みます。
// ---------------------------------------------------------------------------

#mark-rei()

#mondai[
  次の各問について、最も適切なものを選び、その番号を解答欄にマークしなさい。

  #v(.5em)
  (1) 中央銀行が公開市場操作として国債の買いオペレーションを行ったとき、
  短期的に生じると考えられる変化として最も適切なものはどれか。#setmon(answer: 3, point: 3)

  #choicebox((
    [マネタリーベースが減少し、短期金利は上昇する],
    [マネタリーベースが減少し、短期金利は低下する],
    [マネタリーベースが増加し、短期金利は低下する],
    [マネタリーベースが増加し、短期金利は上昇する],
  ))

  #v(.5em)
  (2) 名目利子率が 4%、期待インフレ率が 3% であるとき、
  フィッシャー方程式が近似的に成り立つとすれば、期待実質利子率はいくらか。#setmon(answer: 1, point: 3)

  #choicebox(([1%], [3%], [4%], [7%]), row: 4)

  #v(.5em)
  (3) 公共財の定義に関する記述として正しいものはどれか。#setmon(answer: 2, point: 3)

  #choicebox((
    [消費が競合的であり、かつ排除が可能である],
    [消費が非競合的であり、かつ排除が困難である],
    [消費が非競合的であるが、排除は容易である],
    [消費が競合的であるが、排除は困難である],
  ), row:2)
]

// ---------------------------------------------------------------------------
// セット採点：複数の欄をひとまとまりとして、全部合っているときだけ得点。
// setmons(pattern: "set") が pattern を 2,2,…,8 に展開します。
// 配点は最後の欄にまとめて置かれます（部分点なし）。
// ---------------------------------------------------------------------------

#mondai[
  預金準備率が 5% であり、市中銀行は超過準備を保有せず、
  現金・預金比率は 0 であるとする。このとき信用乗数（貨幣乗数）の値を求め、
  小数第1位まで下の欄にマークしなさい。

  #v(.5em)
  // mode: "array" で3つの欄を受け取り、間に小数点を挟んで並べます。
  // 1回の setmons にまとめることで pattern が 2,2,8 となり、3欄で1つのセットになります。
  #let 欄 = setmons(answers: (2, 0, 0), pattern: "set", point: 6, mode: "array")
  #align(center)[
    信用乗数 ＝ #欄.at(0)#欄.at(1).#欄.at(2)
  ]

  #v(.3em)
  #text(size: .85em)[
    ※ 3つの欄すべてが正しいときのみ得点となります。
  ]
]

// ---------------------------------------------------------------------------
// 下線部への参照：Qunderline でア・イ・ウ… の記号を振り、
// setmons で対応する解答欄をまとめて作ります。
// ---------------------------------------------------------------------------

#mondai[
  // Qref は後方参照しかできない（内部で counter.get() を使っているため）。
  // 本文を先に置き、そのあとで設問文から Qref で指すのが正しい順序になる。
  次の文章を読んで、下の問いに答えなさい。

  #v(.5em)
  #block(inset: (left: 1em))[
    外部不経済が存在する場合、私的限界費用は社会的限界費用を
    #Qunderline(label: "mon1")[上回る]。このとき市場均衡における取引量は、
    社会的に望ましい水準を #Qunderline(label: "mon2")[上回る]。
    この乖離を是正する手段としてピグー税が知られており、
    最適な税率は均衡点における #Qunderline(label: "mon3")[外部限界費用] に等しい。
    一方、当事者間の交渉費用が無視できるほど小さく、権利関係が明確であれば、
    政府の介入がなくても効率的な資源配分が達成されうるという主張は
    #Qunderline(label: "mon4")[コースの定理] と呼ばれる。
  ]

  #v(.5em)
  #Qref("mon1")〜#Qref("mon4", kasen: "")について、内容が正しければ
  #mark-number(1)、誤っていれば #mark-number(2) をマークしなさい。

  #v(.5em)
  #align(center)[
   #let mon = setmons(answers: (2, 1, 1, 1), point: 2, space: 1.2em, mode:"array")
   
   #for i in range(4) { [#Qref("mon"+str(i+1), kasen: ""): ]+ mon.at(i) +" "}
  ]
]

// ---------------------------------------------------------------------------
// 順不同採点：どの欄にどれをマークしてもよく、一致した個数だけ得点。
// setmons(pattern: "npo") が pattern を 1,1,…,9 に展開します。
// 配点は「1個あたりの点数」として扱われます（部分点あり）。
// ---------------------------------------------------------------------------

#mondai[
  次の #choicelist(6) のうち、市場の失敗をもたらす要因として
  適切なものを#strong[3つ]選び、下の3つの欄にマークしなさい。
  #strong[順序は問いません。]

  #choicebox((
    [完全競争市場における多数の売り手の存在],
    [財の消費における外部性],
    [取引当事者間の情報の非対称性],
    [生産技術における規模に関する収穫一定],
    [公共財の非排除性],
    [価格の伸縮的な調整],
  ), row: 2)

  #v(.5em)
  #align(center)[
    #setmons(answers: (2, 3, 5), pattern: "npo", point: 2, space: 1.2em)
  ]

  #v(.3em)
  #text(size: .85em)[
    ※ 正しく選べた1つにつき2点。誤ったものを選んでも減点はしません。
  ]
]

// ---------------------------------------------------------------------------
// 設問番号の相互参照：label を付けておくと monref で番号を呼び出せます。
// 設問を追加・削除しても番号がずれません。
// ---------------------------------------------------------------------------

#mondai[
  (1) 前問で選んだ要因のうち、当事者間の自発的な交渉によって
  効率性が回復しうるとコースが論じたのはどれか。
  該当する選択肢の番号をマークしなさい。#setmon(answer: 2, point: 3, label: "coase")

  #v(.5em)
  (2) 設問 #monref(label: "coase") で答えた状況において、
  交渉費用が大きい場合に有効となる政策手段はどれか。#setmon(answer: 4, point: 3)

  #choicebox((
    [価格の上限規制],
    [参入規制],
    [数量割当],
    [ピグー税],
  ), row: 2)
]
